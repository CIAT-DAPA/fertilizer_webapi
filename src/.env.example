# Configuration file for the HaFAS API. Copy to .env and fill in the values.
# NEVER commit a .env file. Real environment variables override these values.
#
# Where the API looks for it (first match wins, see conf.py):
#   Local dev:  fertilizer_webapi/src/.env   (gitignored)
#   Production: /opt/nagroadvisory/back/.env (root of the server's git clone,
#               one level ABOVE src/; untracked, so `git pull` never touches it)
# Lines may also be written as `export KEY=value`; quotes around values are ok.

# --- Runtime mode -------------------------------------------------------------
# REQUIRED in production. Anything other than "False" turns debug mode on:
# the API then binds to 127.0.0.1 only and uses the local "nextgen" database.
DEBUG=False

# --- GeoServer / rasters (defaults shown; only override if they change) --------
WORKSPACE=fertilizer_et
LAYER_NAME=:et_wheat_fertilizer_recommendation_normal
SERVICE=WFS
GEOSERVER_URL=https://geo.aclimate.org/geoserver/
FERTILIZER_RASTERS_DIR=./raster_files/cropped/

# --- Network / database --------------------------------------------------------
HOST=0.0.0.0
PORT=5000
CONNECTION_DB=mongodb://localhost:27017/nextgen_db

# --- Chatbot / LLM (server-side only; never put this in the frontend) ----------
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=45
# CHATBOT_RATE_LIMIT_PER_MINUTE=20
